# =====================================================================
# Frontend Environment Configuration Template
# Copy this file to .env.local (or .env) and adjust as needed:
#   cp .env.example .env.local
# =====================================================================

# Backend API Base URL
# ---------------------
# Option 1 (Default / Recommended for local development):
# Leave empty or commented out. The frontend will use relative paths ("/api/auth/...")
# and automatically route requests through the Vite reverse proxy defined in vite.config.js
# to http://127.0.0.1:8000 without CORS issues.
# =====================================================================
# Frontend Environment Configuration Template
# Copy this file to .env.local (or .env) and adjust as needed:
#   cp .env.example .env.local
# =====================================================================

# Backend API Base URL
# ---------------------
# Option 1 (Default / Recommended for local development):
# Leave empty or commented out. The frontend will use relative paths ("/api/auth/...")
# and automatically route requests through the Vite reverse proxy defined in vite.config.js
# to http://127.0.0.1:8000 without CORS issues.
VITE_API_BASE_URL=

# Option 2 (Direct connection / External backend):
# Uncomment and set this if your backend is hosted separately or for production:
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL=https://api.yourdomain.com



