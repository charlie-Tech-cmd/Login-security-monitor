# =====================================================================
# Backend Environment Configuration Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# =====================================================================

# Security: Secret key for signing JWT access tokens (minimum 32 characters for HMAC-SHA256)
JWT_SECRET_KEY=your-super-secret-key-at-least-32-chars-long!

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=login_security_monitor

# Optional: Full Database URL override (takes precedence over POSTGRES_* parameters if provided)
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/login_security_monitor

# Optional: Application & Security Policies (default values shown)
# APP_NAME=Login Security Monitor
# MIN_PASSWORD_LENGTH=8
# MAX_FAILED_ATTEMPTS=5
# FAILURE_WINDOW_MINUTES=15
# LOCKOUT_MINUTES=15
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=15

